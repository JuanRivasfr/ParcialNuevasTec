MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49bb90b9e2ea631f08ddba91d72e509f, type: 3}
  m_Name: InitialNarrative
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: NARRADOR
    speakerType: 0
    dialogueText: En la edad 2099, la humanidad vive dentro del Ciberdojo, un sistema
      virtual controlado por codigo puro.
    autoAdvanceDelay: 0
  - speakerName: NARRADOR
    speakerType: 0
    dialogueText: Pero todo cambio cuando aparecio The Syntax Error, un virus que
      ha infectado el mundo digital.
    autoAdvanceDelay: 0
  - speakerName: SYSTEM
    speakerType: 1
    dialogueText: Mis sistemas estan fallando.. Los virus estan por todas partes.
      Necesito a alguien que pueda limpiarlos.
    autoAdvanceDelay: 0
  - speakerName: BYTE
    speakerType: 2
    dialogueText: Soy Byte. He entrenado toda mi vida para este momento. Usare mis
      habilidades para eliminar cada Virus.
    autoAdvanceDelay: 0
  - speakerName: SYSTEM
    speakerType: 1
    dialogueText: "\xA1Preparate, Byte! Tu primer enemigo se acerca!"
    autoAdvanceDelay: 0
